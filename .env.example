# ─────────────────────────────────────────────────────────────────────────────
# VoiceHire AI – Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Database ---------------------------------------------------------------
# Default: SQLite (voicehire.db). For PostgreSQL swap to:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/voicehire
DATABASE_URL=sqlite:///./voicehire.db

# ---- Auth -------------------------------------------------------------------
JWT_SECRET=change-me-to-a-random-32-byte-string

# ---- Local AI Voice (free, no API keys) ------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b          # 8 GB RAM / CPU. Use qwen2.5:7b with 16 GB+ RAM or GPU
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.2
LLM_KEEP_ALIVE=10m
LLM_MAX_TOOL_ROUNDS=4
VOICE_DEMO_FALLBACK=false         # true: labelled keyword demo when Ollama is down

# ---- Speech-to-Text (faster-whisper, local) ---------------------------------
STT_PROVIDER=faster-whisper
STT_MODEL=base.en                 # tiny.en (fastest) | base.en | small.en (more accurate)
STT_LANGUAGE=en
STT_DEVICE=auto
STT_COMPUTE_TYPE=int8
STT_MODEL_DIR=./models/whisper
STT_TIMEOUT_SECONDS=60

# ---- Text-to-Speech (Piper, local, GPL-3.0) ---------------------------------
TTS_PROVIDER=piper
PIPER_VOICE_PATH=./models/piper/en_US-lessac-medium.onnx
TTS_TIMEOUT_SECONDS=30
TTS_MAX_CHARS=600

# ---- Audio limits -----------------------------------------------------------
AUDIO_MAX_BYTES=5000000
AUDIO_MAX_SECONDS=60

# ---- Voice behaviour --------------------------------------------------------
VOICE_DRY_RUN=false               # true: confirmed actions NOT executed (rehearsal)
VOICE_CONFIRMATION_TTL_SECONDS=120
# OLLAMA_ALLOW_REMOTE=false       # keep Ollama on localhost; never expose port 11434

# ═══════════════════════════════════════════════════════════════════════════════
# EMAIL AUTOMATION SYSTEM
# Real delivery requires valid SMTP credentials. Without them, set:
#   EMAIL_DEMO_MODE=true    (default) to simulate emails safely.
# Provider-specific sending limits apply (e.g. Gmail: 500/day free, 2000/day Workspace).
# SMTP credentials are NEVER logged, exposed to the frontend, or committed to Git.
# ═══════════════════════════════════════════════════════════════════════════════

# ---- Email mode -------------------------------------------------------------
# true (default): emails are simulated and stored in DB; never sent to real SMTP.
# false: requires SMTP_HOST, SMTP_USERNAME, SMTP_PASSWORD to be set.
EMAIL_DEMO_MODE=true

# ---- SMTP provider ----------------------------------------------------------
# Gmail example (requires a Google App Password, not your account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USE_SSL=false
#
# Gmail OAuth2 / Workspace SMTP relay: see Google Workspace Admin docs.
# Other providers: Mailgun, SendGrid, AWS SES, etc. – use their SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=            # Use an App Password for Gmail; never your login password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=VoiceHire AI

# ---- Email behaviour --------------------------------------------------------
EMAIL_MAX_RETRIES=5
EMAIL_RETRY_BASE_DELAY_SECONDS=60     # exponential backoff: 60s, 120s, 240s …
EMAIL_REMINDER_DELAY_HOURS=48         # assessment reminder sent 48h after invitation
EMAIL_BULK_CONFIRM_REQUIRED=true      # bulk send always requires confirmed=true

# ---- Automation feature flags -----------------------------------------------
EMAIL_SEND_ASSESSMENT_INVITATIONS=true
EMAIL_SEND_ASSESSMENT_REMINDERS=true
EMAIL_SEND_SUBMISSION_CONFIRMATIONS=true
EMAIL_SEND_INTERVIEW_INVITATIONS=true
EMAIL_SEND_DECISION_NOTIFICATIONS=true    # requires recruiter approval before sending
